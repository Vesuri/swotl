+
+/* Observation only: record original decoder slices; never change cycle budgets,
+ * registers, poll counts or delivery. Zero-count REP is a completed slice too. */
+void SWOTL_RepChunk(uint32_t linear, uint16_t cx, uint16_t si, uint16_t di, bool restart)
+{
+    if (!rep_chunks || !swotl_active || !poll_gate) return;
+    const Location here = Locate(linear);
+    if (!IsPoll(here)) return;
+    const auto it = poll_hits.find(here);
+    if (it == poll_hits.end() || !it->second) E_Exit("SWOTL: REP without poll visit");
+    fprintf(rep_chunks, "%s,0x%05x,%llu,%u,%u,%u,%u,%u,%u,%u,%u\n",
+            modules[here.module].name.c_str(), here.offset,
+            (unsigned long long)service_events, it->second - 1,
+            cx, si, di, (unsigned)reg_cx, (unsigned)reg_si, (unsigned)reg_di,
+            (unsigned)restart);
+}
