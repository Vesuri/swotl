+	const bool held_target = held_next && held_next->module == here.module &&
+	                         held_next->offset == here.offset;
+	if (held_target) ++held_trigger_hits;
+
 	/* Snapshots count after the key script, each after the previous one. */
 	if (key_index == keys.size() && key_held == KBD_NONE)
 		for (auto &t : snapshots) {
@@ -684,7 +698,11 @@
 		}
