@@ -132,6 +132,9 @@
 uint64_t key_release_at = 0;
 KBD_KEYS key_held = KBD_NONE;
 uint64_t key_hold = 600000;
+/* Visits to the next trigger while a key is held, since key-down or the
+ * latest service event. Diagnostic metadata only; never drives input. */
+uint64_t held_trigger_hits = 0;
 std::string exit_after;
 /* Service log (SWOTL_SERVICES=1): every software INT raised by module code, with
  * full registers at entry ("svc") and when execution is back at its return
@@ -220,6 +223,7 @@
 
 void ServiceEvent(const char *kind, const unsigned num) {
 	++service_events;
+	held_trigger_hits = 0;
 	poll_hits.clear();
 	FillFlags();
 	Event(kind, "%02x ax=%04x bx=%04x cx=%04x dx=%04x si=%04x di=%04x bp=%04x sp=%04x ds=%04x es=%04x "
@@ -675,6 +679,16 @@
 	ServiceReturn(linear);
 	if (poll_gate && IsPoll(here)) ++poll_hits[here];
 
+	const Trigger *held_next = nullptr;
