--- /dev/null
+++ b/include/swotl_joystick_input.h
@@ -0,0 +1,26 @@
+#ifndef SWOTL_JOYSTICK_INPUT_H
+#define SWOTL_JOYSTICK_INPUT_H
+#include <string>
+
+/* Normalized axes are thousandths in [-1000,1000]; buttons are a two-bit mask. */
+struct SwotlJoystickInput {
+    char kind = 0;
+    int value = 0;
+};
+inline SwotlJoystickInput SwotlParseJoystick(const std::string &name)
+{
+    if (name.size() == 3 && name[0] == 'j' && name[1] == 'b' &&
+        name[2] >= '0' && name[2] <= '3')
+        return {'b', name[2] - '0'};
+    if (name.size() < 4 || name.size() > 7 || name[0] != 'j' ||
+        (name[1] != 'x' && name[1] != 'y') ||
+        (name[2] != '+' && name[2] != '-')) return {};
+    int value = 0;
+    for (size_t i = 3; i < name.size(); ++i) {
+        if (name[i] < '0' || name[i] > '9') return {};
+        value = value * 10 + name[i] - '0';
+    }
+    if (value > 1000) return {};
+    return {name[1], name[2] == '-' ? -value : value};
+}
+#endif
