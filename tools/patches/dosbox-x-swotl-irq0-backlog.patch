@@ -537,6 +546,23 @@
 static void inline master_startIRQ(Bitu i){
     master.start_irq(i);
     CPU_HW_Interrupt(master.vector_base + i);
+}
+
+/* SWOTL_POLLS: raise one held IRQ0 again once its request bit is free. */
+void SWOTL_Irq0Refill(void) {
+    if (!swotl_irq0_backlog || (master.irr & 1)) return;
+    --swotl_irq0_backlog;
+    swotl_irq0_owed = false;
+    master.lower_irq(0);
+    master.raise_irq(0);
+    /* at once (not after PIC_irq_delay_ns): every owed tick before the sync access */
+    if (master.irr & master.imrr & master.isrr & 1) PIC_IRQCheck = 1;
+}
+
+/* SWOTL_POLLS, before each instruction with IF set: the ungated machine would
+ * take a pending, unmasked IRQ0 not in service here. */
+void SWOTL_Irq0Check(void) {
+    if (master.irr & master.imrr & master.isrr & 1) swotl_irq0_owed = true;
 }
 
