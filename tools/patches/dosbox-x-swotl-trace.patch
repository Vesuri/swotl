diff --git a/include/swotl_trace.h b/include/swotl_trace.h
new file mode 100644
index 0000000..c6b3991
--- /dev/null
+++ b/include/swotl_trace.h
@@ -0,0 +1,25 @@
+/* SWOTL reference instrumentation (Secret Weapons of Luftwaffe port).
+ * Off unless SWOTL_TRACE is set; armed at the SWOTL.EXE MZ entry. */
+#ifndef DOSBOX_SWOTL_TRACE_H
+#define DOSBOX_SWOTL_TRACE_H
+
+#include <stdint.h>
+
+extern bool swotl_active;
+
+void SWOTL_Instruction(uint32_t linear);
+void SWOTL_MemoryAccess(bool write, uint32_t address, uint8_t width);
+void SWOTL_Interrupt(unsigned num, unsigned type, uint32_t oldeip);
+void SWOTL_Port(bool write, uint8_t width, unsigned port, uint32_t value);
+void SWOTL_DosOpen(const char *name, bool ok, uint16_t handle, uint8_t mode);
+void SWOTL_DosClose(uint16_t handle);
+void SWOTL_DosRead(uint16_t handle, uint32_t buffer, uint32_t file_pos,
+                   uint16_t requested, uint16_t actual);
+void SWOTL_DosSeek(uint16_t handle, uint8_t mode, uint32_t result);
+void SWOTL_DosExecOverlay(const char *name, uint16_t load_seg, uint16_t reloc);
+
+static inline bool SWOTL_WatchedAddress(const uint32_t address) {
+	return address < 0xc0000u;
+}
+
+#endif
