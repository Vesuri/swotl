+} // namespace
+
+void SWOTL_Instruction(const uint32_t linear) {
+	if (!swotl_active) {
+		if ((uint16_t)reg_eip != ROOT_ENTRY_IP) return;
+		if (!configured) Configure();
+		if (!enabled || cpu.pmode || SegValue(cs) != (uint16_t)(dos.psp() + 0x10 + ROOT_ENTRY_CS))
+			return;
+		Arm();
+	}
+	++icount;
+	const Location here = Locate(linear);
+	if (here.module) {
+		auto &exec = modules[here.module].executed;
+		if (here.offset >= exec.size()) exec.resize(here.offset + 16, 0);
+		exec[here.offset] = 1;
+	}
+	if ((linear >> 4) < PARAGRAPHS) para_executed[linear >> 4] = 1;
+	const uint64_t packed = Pack(here);
+	if (prev_valid) edges.insert((prev_packed << 32) | packed);
+	prev_packed = packed;
+	prev_valid = true;
+
+	/* Snapshots count after the key script, each after the previous one. */
+	if (key_index == keys.size() && key_held == KBD_NONE)
+		for (auto &t : snapshots) {
+			if (t.done) continue;
+			if (Hit(t, here)) { t.done = true; Snapshot(t); }
+			break;
+		}
+	if (key_held != KBD_NONE && icount >= key_release_at) {
+		KEYBOARD_AddKey(key_held, false);
+		Event("key_up", "%s", keys[key_index - 1].name.c_str());
+		key_held = KBD_NONE;
+		if (key_index < keys.size()) keys[key_index].hits = 0;
+	}
+	if (key_held == KBD_NONE && key_index < keys.size() && Hit(keys[key_index], here)) {
+		auto &t = keys[key_index++];
+		t.done = true;
+		KEYBOARD_AddKey(t.key, true);
+		key_held = t.key;
+		key_release_at = icount + key_hold;
+		Event("key_down", "%s", t.name.c_str());
+	}
+}
+
+void SWOTL_MemoryAccess(const bool write, const uint32_t address, const uint8_t width) {
+	if (in_interrupt_hook) return;
+	const bool is_vga = address >= 0xa0000u && address < 0xc0000u;
+	const uint32_t para = address >> 4;
+	const bool code = write && para < PARAGRAPHS && para_executed[para];
+	if (write && para < PARAGRAPHS && para_module[para]) {
+		const uint64_t w = WRITTEN | Pack(CurrentLocation());
+		for (uint32_t a = address; a < address + width && a < PARAGRAPHS * 16; ++a) last_writer[a] = w;
+	}
+	if (!is_vga && !code) return;
+	const auto source = CurrentLocation();
+	if (is_vga) ++vga_accesses[std::make_tuple(write, width, source, (address - 0xa0000u) & ~0xffu)];
+	if (code) ++code_writes[std::make_tuple(source, address, width)];
+}
+
+void SWOTL_Interrupt(const unsigned num, const unsigned type, const uint32_t oldeip) {
+	if (!swotl_active || cpu.pmode) return;
+	in_interrupt_hook = true;
+	const auto vector = (uint32_t)num << 2;
+	const uint32_t target = ((uint32_t)mem_readw(vector + 2) << 4) + mem_readw(vector);
+	const auto source = Locate(SegPhys(cs) + (uint16_t)oldeip);
+	const bool software = (type & CPU_INT_SOFTWARE) != 0;
+	if (software) last_int_source = source;
+	const uint16_t ax = software ? (uint16_t)reg_ax : 0;
+	++interrupts[std::make_tuple((uint8_t)num, (uint8_t)type, ax, source, Locate(target))];
+	if (software && (num == 0x10 || num == 0x67 || num == 0x33 ||
+	                 (num == 0x21 && (reg_ah == 0x25 || reg_ah == 0x35 || reg_ah == 0x48 ||
+	                                  reg_ah == 0x49 || reg_ah == 0x4a || reg_ah == 0x4b ||
+	                                  reg_ah == 0x4c || reg_ah == 0x44))))
+		Event("int", "%02x ax=%04x bx=%04x cx=%04x dx=%04x ds=%04x es=%04x", num, reg_ax, reg_bx,
+		      reg_cx, reg_dx, SegValue(ds), SegValue(es));
+	if (!software && (num == 0x00 || num == 0x06))
+		Event("fault", "%02x", num);
+	in_interrupt_hook = false;
+}
+
+void SWOTL_Port(const bool write, const uint8_t width, const unsigned port, const uint32_t value) {
+	if (!swotl_active) return;
+	++ports[std::make_tuple(write, width, (uint16_t)port, value, CurrentLocation())];
+}
+
+void SWOTL_DosOpen(const char *name, const bool ok, const uint16_t handle, const uint8_t mode) {
+	if (!swotl_active) return;
+	const auto base = BaseName(name);
+	if (ok) files[handle] = OpenFile{base, 0};
+	Event("open", "%s ok=%d handle=%u mode=%02x", base.c_str(), ok, handle, mode);
+}
+
+void SWOTL_DosClose(const uint16_t handle) {
+	if (!swotl_active) return;
+	const auto it = files.find(handle);
+	Event("close", "%s handle=%u", it == files.end() ? "?" : it->second.name.c_str(), handle);
+	if (it != files.end()) files.erase(it);
+}
+
+void SWOTL_DosRead(const uint16_t handle, const uint32_t buffer, const uint32_t file_pos,
+                   const uint16_t requested, const uint16_t actual) {
+	if (!swotl_active) return;
+	const auto it = files.find(handle);
+	const std::string name = it == files.end() ? "?" : it->second.name;
+	if (IsCodeFile(name)) {
+		const uint16_t id = ModuleId(name);
+		if (file_pos == 0) modules[id].loads++;
+		MapRange(buffer, actual, id, (int32_t)file_pos);
+	} else {
+		MapRange(buffer, actual, 0, 0);
+	}
+	Event("read", "%s handle=%u linear=0x%05x pos=0x%05x req=%u got=%u", name.c_str(), handle,
+	      buffer, file_pos, requested, actual);
+}
+
+void SWOTL_DosSeek(const uint16_t handle, const uint8_t mode, const uint32_t result) {
+	if (!swotl_active) return;
+	const auto it = files.find(handle);
+	Event("seek", "%s handle=%u mode=%u pos=0x%05x", it == files.end() ? "?" : it->second.name.c_str(),
+	      handle, mode, result);
+}
+
+void SWOTL_DosExecOverlay(const char *name, const uint16_t seg, const uint16_t reloc) {
+	if (!swotl_active) return;
+	Event("exec_overlay", "%s seg=0x%04x reloc=0x%04x", BaseName(name).c_str(), seg, reloc);
+}
