diff --git a/src/misc/swotl_trace.cpp b/src/misc/swotl_trace.cpp
new file mode 100644
index 0000000..c988d37
--- /dev/null
+++ b/src/misc/swotl_trace.cpp
@@ -0,0 +1,569 @@
+/* SWOTL reference instrumentation (Secret Weapons of Luftwaffe port).
+ *
+ * Enabled by SWOTL_TRACE=1; armed at the first instruction of SWOTL.EXE
+ * (CS:IP = PSP+10h+1617h:0382h). Every guest address is recorded as
+ * (module, offset): the root image, or the .OVL/.EXE file whose bytes the
+ * last DOS read put at that paragraph. Outputs go to SWOTL_TRACE_DIR (".").
+ *
+ * SWOTL_SNAPSHOTS=name@MODULE+HEX[#N],...  dump state on the Nth execution
+ * SWOTL_EXIT_AFTER=name                    exit(0) after that snapshot
+ * SWOTL_KEYS=MODULE+HEX[#N]=key,...        press key when reached (in order)
+ * SWOTL_KEY_HOLD=instructions              release delay (default 600000)
+ * SWOTL_BIOS_TICKS=n                       BIOS tick count set at arming
+ *                                          (default 0; DOS time and INT 1Ah
+ *                                          derive from it, host time does not
+ *                                          leak in)
+ */
+
+#include "dosbox.h"
+#include "cpu.h"
+#include "regs.h"
+#include "mem.h"
+#include "paging.h"
+#include "dos_inc.h"
+#include "vga.h"
+#include "keyboard.h"
+#include "logging.h"
+#include "swotl_trace.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <sys/stat.h>
+#include <tuple>
+#include <unordered_set>
+#include <vector>
+
+bool swotl_active = false;
+
+extern HostPt MemBase;
+
+namespace {
+
+constexpr uint16_t ROOT_ENTRY_CS = 0x1617;
+constexpr uint16_t ROOT_ENTRY_IP = 0x0382;
+constexpr uint32_t ROOT_IMAGE_BYTES = 96000;
+constexpr uint32_t PARAGRAPHS = 0x10000 + 0x1000;
+
+struct Module {
+	std::string name;
+	std::vector<uint8_t> executed;
+	uint32_t loads = 0;
+};
+
+struct Location {
+	uint16_t module; /* 0 = none: offset is the linear address */
+	uint32_t offset;
+	bool operator<(const Location &o) const {
+		return std::tie(module, offset) < std::tie(o.module, o.offset);
+	}
+};
+
+struct Trigger {
+	std::string name;
+	uint16_t module = 0;
+	std::string module_name;
+	uint32_t offset = 0;
+	uint32_t count = 1;
+	uint32_t hits = 0;
+	KBD_KEYS key = KBD_NONE;
+	bool done = false;
+};
+
+struct OpenFile {
+	std::string name;
+	uint32_t pos = 0;
+};
+
+bool configured = false;
+bool enabled = false;
+std::string out_dir = ".";
+uint16_t load_seg = 0;
+uint64_t icount = 0;
+
+std::vector<Module> modules(1, Module{"-", {}, 0});
+std::vector<uint16_t> para_module(PARAGRAPHS, 0);
+std::vector<int32_t> para_offset(PARAGRAPHS, 0);
+std::vector<uint8_t> para_executed(PARAGRAPHS, 0);
+/* Last CPU writer per byte since the byte was last loaded from a file. */
+constexpr uint64_t WRITTEN = 1ull << 63;
+std::vector<uint64_t> last_writer(PARAGRAPHS * 16, 0);
+
+bool prev_valid = false;
+uint64_t prev_packed = 0;
+std::unordered_set<uint64_t> edges;
+bool in_interrupt_hook = false;
+Location last_int_source{0, 0};
+
+std::map<std::tuple<uint8_t, uint8_t, uint16_t, Location, Location>, uint64_t> interrupts;
+std::map<std::tuple<bool, uint8_t, uint16_t, uint32_t, Location>, uint64_t> ports;
+std::map<std::tuple<bool, uint8_t, Location, uint32_t>, uint64_t> vga_accesses;
+std::map<std::tuple<Location, uint32_t, uint8_t>, uint64_t> code_writes;
+std::map<uint16_t, OpenFile> files;
+FILE *events = nullptr;
+
+std::vector<Trigger> snapshots;
+std::vector<Trigger> keys;
+size_t key_index = 0;
+uint64_t key_release_at = 0;
+KBD_KEYS key_held = KBD_NONE;
+uint64_t key_hold = 600000;
+std::string exit_after;
+
+std::string Path(const std::string &file) { return out_dir + "/" + file; }
+
+std::string BaseName(const char *path) {
+	std::string s(path);
+	const auto cut = s.find_last_of("\\/:");
+	if (cut != std::string::npos) s = s.substr(cut + 1);
+	for (auto &c : s) c = (char)toupper((unsigned char)c);
+	return s;
+}
+
+bool IsCodeFile(const std::string &name) {
+	const auto dot = name.rfind('.');
+	if (dot == std::string::npos) return false;
+	const auto ext = name.substr(dot);
+	return ext == ".OVL" || ext == ".EXE";
+}
+
+uint16_t ModuleId(const std::string &name) {
+	for (size_t i = 1; i < modules.size(); ++i)
+		if (modules[i].name == name) return (uint16_t)i;
+	modules.push_back(Module{name, {}, 0});
+	return (uint16_t)(modules.size() - 1);
+}
+
+Location Locate(const uint32_t linear) {
+	const uint32_t para = linear >> 4;
+	if (para >= PARAGRAPHS || para_module[para] == 0) return {0, linear};
+	return {para_module[para], (uint32_t)(para_offset[para] + (int32_t)(linear & 15))};
+}
+
+uint64_t Pack(const Location &l) { return ((uint64_t)l.module << 24) | (l.offset & 0xffffff); }
+
+Location CurrentLocation() { return Locate(SegPhys(cs) + (uint16_t)reg_eip); }
+
+/* DOS services run in DOSBox callbacks: attribute them to the guest INT. */
+Location EventLocation() {
+	const auto here = CurrentLocation();
+	return here.module == 0 && here.offset >= 0xf0000u ? last_int_source : here;
+}
+
+void Event(const char *kind, const char *fmt, ...) {
+	if (!events) return;
+	const auto where = EventLocation();
+	fprintf(events, "%llu,%s,%s,0x%05x,", (unsigned long long)icount, kind,
+	        modules[where.module].name.c_str(), where.offset);
+	va_list args;
+	va_start(args, fmt);
+	vfprintf(events, fmt, args);
+	va_end(args);
+	fputc('\n', events);
+}
+
+void MapRange(const uint32_t linear, const uint32_t length, const uint16_t module,
+              const int32_t module_offset) {
+	/* Only paragraphs the read covers completely change owner. */
+	const uint32_t first = (linear + 15) >> 4, end = (linear + length) >> 4;
+	for (uint32_t para = first; para < end && para < PARAGRAPHS; ++para) {
+		para_module[para] = module;
+		para_offset[para] = module_offset + (int32_t)(para * 16) - (int32_t)linear;
+		para_executed[para] = 0;
+	}
+	for (uint32_t a = linear; a < linear + length && a < PARAGRAPHS * 16; ++a) last_writer[a] = 0;
+}
+
+/* Runs of bytes in module-owned paragraphs with the same last CPU writer. */
+void WriteWriters(FILE *f) {
+	fputs("first_linear,last_linear,writer_module,writer_offset\n", f);
+	uint32_t start = 0;
+	for (uint32_t a = 1; a <= PARAGRAPHS * 16; ++a) {
+		if (a < PARAGRAPHS * 16 && last_writer[a] == last_writer[start] &&
+		    para_module[a >> 4] == para_module[start >> 4])
+			continue;
+		const uint64_t w = last_writer[start];
+		if (w && para_module[start >> 4]) {
+			const uint16_t m = (uint16_t)((w & ~WRITTEN) >> 24);
+			fprintf(f, "0x%05x,0x%05x,%s,0x%05x\n", start, a - 1, modules[m].name.c_str(),
+			        (uint32_t)(w & 0xffffff));
+		}
+		start = a;
+	}
+}
+
+void WriteFile(const std::string &file, const void *data, size_t size) {
+	if (auto *f = fopen(Path(file).c_str(), "wb")) {
+		fwrite(data, 1, size, f);
+		fclose(f);
+	}
+}
+
+void WriteLocation(FILE *f, const Location &l) {
+	fprintf(f, "%s,0x%05x", modules[l.module].name.c_str(), l.offset);
+}
+
+void WriteModuleMap(FILE *f) {
+	fputs("first_para,last_para,module,module_offset\n", f);
+	uint32_t start = 0;
+	for (uint32_t para = 1; para <= PARAGRAPHS; ++para) {
+		const bool split = para == PARAGRAPHS || para_module[para] != para_module[start] ||
+		                   para_offset[para] != para_offset[start] + (int32_t)(para - start) * 16;
+		if (!split) continue;
+		if (para_module[start])
+			fprintf(f, "0x%05x,0x%05x,%s,0x%05x\n", start, para - 1,
+			        modules[para_module[start]].name.c_str(), para_offset[start]);
+		start = para;
+	}
+}
+
+void WriteOutputs() {
+	if (!enabled) return;
+	if (events) fflush(events);
+	if (auto *f = fopen(Path("modules.csv").c_str(), "w")) {
+		fputs("module,loads,executed_bytes,size\n", f);
+		for (size_t i = 1; i < modules.size(); ++i) {
+			auto &m = modules[i];
+			const auto n = std::count(m.executed.begin(), m.executed.end(), 1);
+			fprintf(f, "%s,%u,%ld,%zu\n", m.name.c_str(), m.loads, (long)n, m.executed.size());
+			WriteFile("executed-" + m.name + ".bin", m.executed.data(), m.executed.size());
+		}
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("residency.csv").c_str(), "w")) {
+		WriteModuleMap(f);
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("edges.csv").c_str(), "w")) {
+		std::vector<uint64_t> sorted(edges.begin(), edges.end());
+		std::sort(sorted.begin(), sorted.end());
+		fputs("from_module,from_offset,to_module,to_offset\n", f);
+		for (const auto e : sorted) {
+			const Location from{(uint16_t)(e >> 56), (uint32_t)(e >> 32) & 0xffffff};
+			const Location to{(uint16_t)((e >> 24) & 0xff), (uint32_t)e & 0xffffff};
+			WriteLocation(f, from);
+			fputc(',', f);
+			WriteLocation(f, to);
+			fputc('\n', f);
+		}
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("interrupts.csv").c_str(), "w")) {
+		fputs("vector,type,ax,source_module,source_offset,target_module,target_offset,count\n", f);
+		for (const auto &item : interrupts) {
+			fprintf(f, "0x%02x,%u,0x%04x,", std::get<0>(item.first), std::get<1>(item.first),
+			        std::get<2>(item.first));
+			WriteLocation(f, std::get<3>(item.first));
+			fputc(',', f);
+			WriteLocation(f, std::get<4>(item.first));
+			fprintf(f, ",%llu\n", (unsigned long long)item.second);
+		}
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("ports.csv").c_str(), "w")) {
+		fputs("direction,width,port,value,source_module,source_offset,count\n", f);
+		for (const auto &item : ports) {
+			fprintf(f, "%s,%u,0x%04x,0x%04x,", std::get<0>(item.first) ? "out" : "in",
+			        std::get<1>(item.first), std::get<2>(item.first), std::get<3>(item.first));
+			WriteLocation(f, std::get<4>(item.first));
+			fprintf(f, ",%llu\n", (unsigned long long)item.second);
+		}
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("vga.csv").c_str(), "w")) {
+		fputs("direction,width,source_module,source_offset,page,count\n", f);
+		for (const auto &item : vga_accesses) {
+			fprintf(f, "%s,%u,", std::get<0>(item.first) ? "write" : "read", std::get<1>(item.first));
+			WriteLocation(f, std::get<2>(item.first));
+			fprintf(f, ",0x%05x,%llu\n", std::get<3>(item.first), (unsigned long long)item.second);
+		}
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("code-writes.csv").c_str(), "w")) {
+		fputs("writer_module,writer_offset,target_linear,width,count\n", f);
+		for (const auto &item : code_writes) {
+			WriteLocation(f, std::get<0>(item.first));
+			fprintf(f, ",0x%05x,%u,%llu\n", std::get<1>(item.first), std::get<2>(item.first),
+			        (unsigned long long)item.second);
+		}
+		fclose(f);
+	}
+	if (auto *f = fopen(Path("summary.txt").c_str(), "w")) {
+		fprintf(f, "load_seg=0x%04x\ninstructions=%llu\nedges=%zu\n", load_seg,
+		        (unsigned long long)icount, edges.size());
+		fclose(f);
+	}
+	if (events) fclose(events);
+	events = nullptr;
+	LOG_MSG("SWOTL: wrote trace to %s (%llu instructions)", out_dir.c_str(),
+	        (unsigned long long)icount);
+}
+
+bool ParseTarget(const std::string &spec, Trigger &t) {
+	const auto plus = spec.find('+');
+	if (plus == std::string::npos) return false;
+	t.module_name = spec.substr(0, plus);
+	for (auto &c : t.module_name) c = (char)toupper((unsigned char)c);
+	const auto hash = spec.find('#', plus);
+	t.offset = (uint32_t)strtoul(spec.substr(plus + 1, hash - plus - 1).c_str(), nullptr, 16);
+	if (hash != std::string::npos) t.count = (uint32_t)strtoul(spec.c_str() + hash + 1, nullptr, 10);
+	t.module = ModuleId(t.module_name);
+	return true;
+}
+
+std::vector<std::string> Split(const char *s, const char sep) {
+	std::vector<std::string> out;
+	if (!s) return out;
+	std::string cur;
+	for (; *s; ++s) {
+		if (*s == sep) { if (!cur.empty()) out.push_back(cur); cur.clear(); }
+		else cur += *s;
+	}
+	if (!cur.empty()) out.push_back(cur);
+	return out;
+}
+
+KBD_KEYS KeyByName(const std::string &n) {
+	static const std::map<std::string, KBD_KEYS> named = {
+	        {"enter", KBD_enter}, {"esc", KBD_esc}, {"space", KBD_space}, {"tab", KBD_tab},
+	        {"up", KBD_up}, {"down", KBD_down}, {"left", KBD_left}, {"right", KBD_right},
+	        {"backspace", KBD_backspace}, {"f1", KBD_f1}, {"f2", KBD_f2}, {"f3", KBD_f3},
+	        {"f4", KBD_f4}, {"f5", KBD_f5}, {"f6", KBD_f6}, {"f7", KBD_f7}, {"f8", KBD_f8},
+	        {"f9", KBD_f9}, {"f10", KBD_f10}};
+	const auto it = named.find(n);
+	if (it != named.end()) return it->second;
+	static const char *letters = "qwertyuiopasdfghjklzxcvbnm";
+	static const KBD_KEYS letter_keys[] = {
+	        KBD_q, KBD_w, KBD_e, KBD_r, KBD_t, KBD_y, KBD_u, KBD_i, KBD_o, KBD_p, KBD_a, KBD_s, KBD_d,
+	        KBD_f, KBD_g, KBD_h, KBD_j, KBD_k, KBD_l, KBD_z, KBD_x, KBD_c, KBD_v, KBD_b, KBD_n, KBD_m};
+	if (n.size() == 1 && strchr(letters, n[0])) return letter_keys[strchr(letters, n[0]) - letters];
+	if (n.size() == 1 && n[0] >= '1' && n[0] <= '9') return (KBD_KEYS)(KBD_1 + (n[0] - '1'));
+	if (n == "0") return KBD_0;
+	return KBD_NONE;
+}
+
+void Configure() {
+	configured = true;
+	const char *trace = getenv("SWOTL_TRACE");
+	enabled = trace && *trace && strcmp(trace, "0") != 0;
+	if (!enabled) return;
+	if (const char *dir = getenv("SWOTL_TRACE_DIR")) out_dir = dir;
+	mkdir(out_dir.c_str(), 0755);
+	if (const char *hold = getenv("SWOTL_KEY_HOLD")) key_hold = strtoull(hold, nullptr, 10);
+	if (const char *e = getenv("SWOTL_EXIT_AFTER")) exit_after = e;
+	for (const auto &spec : Split(getenv("SWOTL_SNAPSHOTS"), ',')) {
+		Trigger t;
+		const auto at = spec.find('@');
+		if (at == std::string::npos || !ParseTarget(spec.substr(at + 1), t))
+			E_Exit("SWOTL: bad snapshot spec '%s'", spec.c_str());
+		t.name = spec.substr(0, at);
+		snapshots.push_back(t);
+	}
+	for (const auto &spec : Split(getenv("SWOTL_KEYS"), ',')) {
+		Trigger t;
+		const auto eq = spec.rfind('=');
+		if (eq == std::string::npos || !ParseTarget(spec.substr(0, eq), t))
+			E_Exit("SWOTL: bad key spec '%s'", spec.c_str());
+		t.name = spec.substr(eq + 1);
+		t.key = KeyByName(t.name);
+		if (t.key == KBD_NONE) E_Exit("SWOTL: unknown key '%s'", t.name.c_str());
+		keys.push_back(t);
+	}
+	events = fopen(Path("events.csv").c_str(), "w");
+	if (events) fputs("icount,kind,module,offset,detail\n", events);
+	std::atexit(WriteOutputs);
+}
+
+void Snapshot(const Trigger &t) {
+	const std::string dir = Path("snap-" + t.name);
+	mkdir(dir.c_str(), 0755);
+	const std::string prefix = "snap-" + t.name + "/";
+	WriteFile(prefix + "ram.bin", MemBase, 0x100000);
+	if (vga.mem.linear) WriteFile(prefix + "vram.bin", vga.mem.linear, vga.mem.memsize);
+	uint8_t dac[768];
+	for (int i = 0; i < 256; ++i) {
+		dac[i * 3] = vga.dac.rgb[i].red;
+		dac[i * 3 + 1] = vga.dac.rgb[i].green;
+		dac[i * 3 + 2] = vga.dac.rgb[i].blue;
+	}
+	WriteFile(prefix + "dac.bin", dac, sizeof dac);
+	if (auto *f = fopen(Path(prefix + "regs.txt").c_str(), "w")) {
+		fprintf(f, "icount=%llu\nhits=%u\n", (unsigned long long)icount, t.hits);
+		fprintf(f, "ax=%04x bx=%04x cx=%04x dx=%04x si=%04x di=%04x bp=%04x sp=%04x\n",
+		        reg_ax, reg_bx, reg_cx, reg_dx, reg_si, reg_di, reg_bp, reg_sp);
+		fprintf(f, "cs=%04x ip=%04x ds=%04x es=%04x ss=%04x flags=%04x\n", SegValue(cs),
+		        (uint16_t)reg_eip, SegValue(ds), SegValue(es), SegValue(ss),
+		        (uint16_t)reg_flags);
+		fprintf(f, "load_seg=%04x vga_mode=%02x\n", load_seg, mem_readb(0x449));
+		fclose(f);
+	}
+	if (auto *f = fopen(Path(prefix + "residency.csv").c_str(), "w")) {
+		WriteModuleMap(f);
+		fclose(f);
+	}
+	if (auto *f = fopen(Path(prefix + "writes.csv").c_str(), "w")) {
+		WriteWriters(f);
+		fclose(f);
+	}
+	Event("snapshot", "%s", t.name.c_str());
+	LOG_MSG("SWOTL: snapshot %s at icount %llu", t.name.c_str(), (unsigned long long)icount);
+	if (t.name == exit_after) {
+		if (auto *f = fopen(Path("exit.txt").c_str(), "w")) {
+			fprintf(f, "snapshot %s\n", t.name.c_str());
+			fclose(f);
+		}
+		std::exit(0);
+	}
+}
+
+bool Hit(Trigger &t, const Location &here) {
+	return !t.done && t.module == here.module && t.offset == here.offset && ++t.hits >= t.count;
+}
+
+void Arm() {
+	load_seg = (uint16_t)(SegValue(cs) - ROOT_ENTRY_CS);
+	const uint16_t root = ModuleId("SWOTL.EXE");
+	modules[root].loads++;
+	const char *ticks = getenv("SWOTL_BIOS_TICKS");
+	mem_writed(0x46c, ticks ? (uint32_t)strtoul(ticks, nullptr, 0) : 0);
+	mem_writeb(0x470, 0);
+	MapRange((uint32_t)load_seg << 4, ROOT_IMAGE_BYTES, root, 0);
+	swotl_active = true;
+	Event("arm", "load_seg=0x%04x psp=0x%04x bios_ticks=0x%08x", load_seg, dos.psp(),
+	      mem_readd(0x46c));
+	LOG_MSG("SWOTL: armed, root load segment %04x", load_seg);
+}
