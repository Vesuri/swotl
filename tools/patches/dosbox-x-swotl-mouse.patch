+
+// Test input uses the platform contract: one count = one logical coordinate
+// unit (two vertical mickeys after the standard INT33 reset). Feed the real
+// DOS driver event path, normalizing its frontend sensitivity/rate first.
+// Called only by the explicitly armed SWOTL reference script.
+void SWOTL_MouseInput(int dx, int dy, int buttons) {
+    swotl_mouse_captured = true;
+    const bool was_locked = user_cursor_locked;
+    extern MOUSE_EMULATION user_cursor_emulation;
+    const auto was_emulation = user_cursor_emulation;
+    user_cursor_locked = true;
+    user_cursor_emulation = MOUSE_EMULATION_ALWAYS;
+    if (dx || dy) {
+        float x = dx / mouse.pixelPerMickey_x;
+        float y = dy / mouse.pixelPerMickey_y;
+        if (fabs(x) > 1.0 || mouse.senv_x < 1.0) x /= mouse.senv_x;
+        if (fabs(y) > 1.0 || mouse.senv_y < 1.0) y /= mouse.senv_y;
+        Mouse_CursorMoved(x, y, 0, 0, true);
+    }
+    if (buttons >= 0) {
+        for (unsigned b = 0; b < 3; ++b) {
+            if (buttons & (1 << b)) Mouse_ButtonPressed(b);
+            else Mouse_ButtonReleased(b);
+        }
+    }
+    user_cursor_emulation = was_emulation;
+    user_cursor_locked = was_locked;
+}
