+bool MouseAction(const std::string &n) {
+    if (n.size() == 3 && n.substr(0, 2) == "mb" && n[2] >= '0' && n[2] <= '7') return true;
+    if (n.size() < 4 || n[0] != 'm' || (n[1] != 'x' && n[1] != 'y') ||
+        (n[2] != '+' && n[2] != '-')) return false;
+    for (size_t i = 3; i < n.size(); ++i) if (!isdigit((unsigned char)n[i])) return false;
+    return true;
+}
