+/* Reference-only external host clock. DOS-managed timestamps still use
+ * UpdateLocalDateTime; only host filesystem modification times are pinned. */
+static bool swotl_fixed_file_clock() {
+    const char *v = getenv("SWOTL_FIXED_FILE_CLOCK");
+    return v && strcmp(v, "1") == 0;
+}
+
+static void swotl_stamp_host(FILE *file) {
+    if (!swotl_fixed_file_clock()) return;
+    struct tm fixed = {};
+    fixed.tm_year = 91;
+    fixed.tm_mon = 0;
+    fixed.tm_mday = 1;
+    fixed.tm_hour = 12;
+    fixed.tm_isdst = -1;
+    const time_t stamp = mktime(&fixed);
+#ifdef WIN32
+    struct _utimbuf times = {stamp, stamp};
+    const int result = _futime(_fileno(file), &times);
+#else
+    struct timeval times[2] = {{stamp, 0}, {stamp, 0}};
+    const int result = futimes(fileno(file), times);
+#endif
+    if (result) E_Exit("SWOTL: cannot pin host file clock");
+}
