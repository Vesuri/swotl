# Milestone state is captured at the original guest label. The visible image
# is captured at that exact queued publication's VBI handoff, if still pending.
# A replacement publication is an error, not a reason to compare a later frame.
# Filled by make test-amiga; outputs keep the existing reference comparisons.
set pagination off
set confirm off
break plat_exit
commands
  silent
  printf "SWOTL_MILESTONE_EXIT\n"
  quit 1
end
break *rt_stop
commands
  silent
  x/s *(char **)($sp+4)
  quit 1
end
break @LABEL@
continue
disable $bpnum
set $bm = &amiga_bitmap
printf "SWOTL_REGS ax=%04x cx=%04x dx=%04x bx=%04x sp=%04x bp=%04x si=%04x di=%04x bpr=%d\n", $d0 & 0xffff, $d1 & 0xffff, $d2 & 0xffff, $d3 & 0xffff, ($d4 ^ 0x7fff) & 0xffff, ($d5 ^ 0x7fff) & 0xffff, (unsigned)$a4 & 0xffff, (unsigned)$a5 & 0xffff, $bm ? $bm->BytesPerRow : 0
set $g = *(unsigned char **)&rt_guest
dump binary memory @OUT@/state.bin $g+1 $g+17
dump binary memory @OUT@/ram.bin $g-0xfffff $g+1
set $d = (char *)rt_dac
dump binary memory @OUT@/dac.bin $d $d+768
set $display = Swotl::application->display
if $display->queue.pending >= 0
  set $serial = $display->queuedSerial
  break *amiga_display_shown
  continue
  if *(unsigned int *)($sp+4) != $serial || amiga_display_late
    printf "SWOTL_MILESTONE_WRONG_HANDOFF\n"
    quit 1
  end
end
if $bm
  set $n = $bm->BytesPerRow * 200
  set $p = (char *)$bm->Planes[0]
  dump binary memory @OUT@/plane0.bin $p $p+$n
  set $p = (char *)$bm->Planes[1]
  dump binary memory @OUT@/plane1.bin $p $p+$n
  set $p = (char *)$bm->Planes[2]
  dump binary memory @OUT@/plane2.bin $p $p+$n
  set $p = (char *)$bm->Planes[3]
  dump binary memory @OUT@/plane3.bin $p $p+$n
  set $p = (char *)$bm->Planes[4]
  dump binary memory @OUT@/plane4.bin $p $p+$n
  set $p = (char *)$bm->Planes[5]
  dump binary memory @OUT@/plane5.bin $p $p+$n
  set $p = (char *)$bm->Planes[6]
  dump binary memory @OUT@/plane6.bin $p $p+$n
  set $p = (char *)$bm->Planes[7]
  dump binary memory @OUT@/plane7.bin $p $p+$n
  set $c = (char *)amiga_colours
  dump binary memory @OUT@/colours.bin $c $c+sizeof(amiga_colours)
end
printf "SWOTL_MILESTONE_OK\n"
quit 0
